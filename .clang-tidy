# SPDX-License-Identifier: Apache-2.0
---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once
WarningsAsErrors: '*'
# Editors use this filter. `make lint-cpp` passes --header-filter anchored to
# the checkout, so headers under build/ (downloaded test dependencies) are never
# checked; that also works with clang-tidy releases that do not know
# ExcludeHeaderFilterRegex.
HeaderFilterRegex: '.*/include/phm/.*|.*/(src|tests)/.*'
FormatStyle: file
...
